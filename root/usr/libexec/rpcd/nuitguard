#!/usr/bin/ucode
import * as fs from 'fs';
import { request_reset, resetting } from '/usr/libexec/nuitguard/reset.uc';
import { status, queue_action } from '/usr/libexec/nuitguard/control.uc';
import { save_password } from '/usr/libexec/nuitguard/credentials.uc';
import { create_identities, generate_pool } from '/usr/libexec/nuitguard/identity.uc';
import { read_settings } from '/usr/libexec/nuitguard/settings.uc';

let methods = { reset: { confirm: false }, status: {}, set_password: { password: '', clear: false }, action: { action: '', role: '' }, generate_pool: { size: 0 } };
if (ARGV[0] == 'list') { printf('%J\n', methods); exit(0); }
if (ARGV[0] != 'call' || !methods[ARGV[1]]) exit(1);
try {
	let input = json(fs.stdin.read('all') || '{}');
	let result;
	if (ARGV[1] == 'status') result = status();
	else if (ARGV[1] == 'reset') result = request_reset(input.confirm);
	else if (resetting()) result = { result: 'busy' };
	else if (ARGV[1] == 'set_password') result = save_password(input.password, input.clear === true);
	else if (ARGV[1] == 'generate_pool') {
		let settings = read_settings(), identities = create_identities(), excluded = [...settings.main.mac_pool];
		for (let role in ['wired', 'wifi']) {
			if (identities.get(role)?.mac) push(excluded, identities.get(role).mac);
			if (settings.main['fixed_mac_' + role]) push(excluded, settings.main['fixed_mac_' + role]);
		}
		result = { pool: generate_pool(input.size, excluded) };
	}
	else result = queue_action(input.action, input.role);
	printf('%J\n', result);
}
catch (error) { printf('%J\n', { error: 'request_failed' }); exit(1); }
