msgid "A configuration or network operation could not be completed"
msgstr "设置未能生效，或网络操作失败"

msgid "A network operation failed; the service stopped and attempted to restore its changes"
msgstr "网络操作失败，服务已停止并尝试恢复原有网络设置"

msgid "A radio shared with a local access point may change channel and briefly disconnect its clients when the uplink connects"
msgstr "如果与路由器热点共用无线网卡，连接校园 Wi-Fi 时可能切换信道，热点下的设备会短暂断网"

msgid "Accepted"
msgstr "操作已提交"

msgid "Account type"
msgstr "账号类型"

msgid "Also wait up to this long after login for the campus network to assign an online address"
msgstr "认证成功后，也会等待这段时间，让校园网完成地址分配"

msgid "Alternate"
msgstr "备用"

msgid "Alternate uplink attempt limit reached"
msgstr "备用线路多次连接失败，暂时停止重试"

msgid "Another action is already queued"
msgstr "已有操作等待执行，请稍后再试"

msgid "Attempts to find the campus login page"
msgstr "查找校园网登录页的尝试次数"

msgid "Authenticate now"
msgstr "立即认证"

msgid "Authenticating"
msgstr "正在认证"

msgid "Authentication"
msgstr "认证"

msgid "Authentication attempt limit reached"
msgstr "认证失败次数已达上限，暂时停止重试"

msgid "Authentication portal"
msgstr "校园网登录设置"

msgid "Authentication requested; check the status page for the result"
msgstr "已提交认证，可在状态页查看进度"

msgid "Authentication retries"
msgstr "认证重试"

msgid "Automatic campus authentication and connection recovery with private MAC addresses"
msgstr "自动完成校园网认证、恢复断开的连接，并支持使用隐私 MAC 地址"

msgid "Automatically switch connections"
msgstr "自动切换线路"

msgid "Backup connection attempts"
msgstr "备用线路连接尝试上限"

msgid "Backup connection mode"
msgstr "备用线路连接方式"

msgid "Both actions stop the service and restore its network changes; only a complete reset removes the saved account"
msgstr "两种重置都会停止服务并恢复原有网络设置；“彻底重置”还会删除已保存的账号"

msgid "Campus WLAN Guard"
msgstr "校园网守卫"

msgid "Campus Wi-Fi SSID"
msgstr "校园 Wi-Fi 名称（SSID）"

msgid "Campus Wi-Fi network"
msgstr "校园 Wi-Fi 网络"

msgid "Campus account"
msgstr "校园网账号"

msgid "Campus credentials are missing"
msgstr "请先填写校园网账号和密码"

msgid "Campus login page"
msgstr "校园网登录页"

msgid "Campus login server address"
msgstr "校园网登录服务器地址"

msgid "Campus network connected"
msgstr "校园网已连接"

msgid "Cancel"
msgstr "取消"

msgid "Change MAC during connection recovery"
msgstr "恢复连接时更换"

msgid "Change MAC on a schedule"
msgstr "按计划定时更换"

msgid "Check interval while confirming an outage (seconds)"
msgstr "确认断网期间的检测间隔（秒）"

msgid "Check interval while online (seconds)"
msgstr "在线时的检测间隔（秒）"

msgid "Check now"
msgstr "立即检测"

msgid "Choose Student or Staff, or enter the service identifier used by your campus"
msgstr "选择学生或教职工；如果学校使用其他账号类型，可填写对应的服务标识"

msgid "Choose a preset or enter a custom URL; presets use HTTP 204 with an empty response"
msgstr "可以选择预设，也可以填写自己的检测地址；预设地址正常联网时返回 204，正文为空"

msgid "Choose different interfaces for Ethernet and Wi-Fi"
msgstr "有线与无线网络请选择不同接口"

msgid "Close"
msgstr "关闭"

msgid "Configure an internet check URL before enabling recovery"
msgstr "请先选择或填写公网检测地址，再启用自动恢复"

msgid "Configure uplink"
msgstr "设置这条线路"

msgid "Confirm reset"
msgstr "确认重置"

msgid "Confirming an outage"
msgstr "正在确认断网"

msgid "Confirming internet access"
msgstr "正在确认公网连通性"

msgid "Connect after a failure"
msgstr "故障时再连接"

msgid "Connecting"
msgstr "正在连接"

msgid "Connection switches per outage"
msgstr "每次故障的线路切换上限"

msgid "Connectivity checks"
msgstr "连通性检测"

msgid "Consecutive failed checks to confirm an outage"
msgstr "确认断网所需的连续检测失败次数"

msgid "Consecutive successful checks before returning"
msgstr "切回前连续检测成功次数"

msgid "Continuous online time before returning (seconds)"
msgstr "切回前所需的持续在线时间（秒）"

msgid "Continuous online time to reset retry counts (seconds)"
msgstr "重置重试次数所需的持续在线时间（秒）"

msgid "Cooldown and limits"
msgstr "冷却与限制"

msgid "Cooling down"
msgstr "冷却中"

msgid "Could not apply the managed network settings"
msgstr "网络设置未能生效"

msgid "Could not bring up the uplink interface"
msgstr "这条线路的网络接口启动失败"

msgid "Could not confirm logout of the private MAC session; network restoration continued"
msgstr "尚未确认校园网是否已注销，已继续恢复原有网络设置"

msgid "Could not finish restoring the network settings"
msgstr "部分网络设置未能恢复，请检查路由器网络"

msgid "Could not generate a private MAC address"
msgstr "MAC 地址生成失败，请重试"

msgid "Could not generate the MAC pool"
msgstr "MAC 地址池生成失败，请重试"

msgid "Could not match the portal IP and MAC to the current uplink"
msgstr "登录页中的 IP 或 MAC 与当前线路未能对应，请检查登录页是否属于这条线路"

msgid "Could not restore the original interface state"
msgstr "网络接口未能恢复到原来的状态"

msgid "Could not save the password"
msgstr "密码保存失败，请重试"

msgid "Could not start initialization; another operation may be running"
msgstr "重置未能开始，可能有其他操作正在执行"

msgid "Could not stop the service or restore its network changes; plugin data was not cleared"
msgstr "服务未能停止，或原有网络设置未能恢复；尚未清除插件数据"

msgid "Could not submit the action"
msgstr "操作提交失败，请重试"

msgid "Counted separately for Ethernet and Wi-Fi; reset after sustained internet access or a manual resume, not after cooldown"
msgstr "有线和无线分别计数；稳定联网或手动恢复后重新计数，冷却结束不会清零"

msgid "Create an open network client"
msgstr "连接无需密码的校园 Wi-Fi"

msgid "Created when connected"
msgstr "连接时创建"

msgid "Custom network"
msgstr "自定义网络"

msgid "Daily"
msgstr "每天"

msgid "Day of the week"
msgstr "星期"

msgid "Debug"
msgstr "调试"

msgid "Enable Campus WLAN Guard"
msgstr "启用校园网守卫"

msgid "Enable scheduled MAC changes"
msgstr "启用定时更换 MAC"

msgid "Enable the service and apply the settings before authenticating"
msgstr "请先启用服务，点击“保存并应用”后再认证"

msgid "Enable the service in Settings and apply the configuration"
msgstr "请先在设置中启用服务，再点击“保存并应用”"

msgid "Enter a locally administered unicast MAC address"
msgstr "请输入本地管理的单播 MAC 地址"

msgid "Enter a time in HH:MM format"
msgstr "请输入 HH:MM 格式的时间"

msgid "Enter a whole number from %s to %s"
msgstr "请输入 %s 到 %s 之间的整数"

msgid "Enter an HTTP or HTTPS URL without credentials or a fragment"
msgstr "请填写 http:// 或 https:// 开头的地址，不要包含账号、密码或 # 后面的内容"

msgid "Enter an HTTP or HTTPS origin without a path"
msgstr "请填写 http:// 或 https:// 开头的服务器地址，只保留主机和端口，不要添加路径"

msgid "Enter an SSID of 1 to 32 bytes"
msgstr "请输入长度为 1 至 32 字节的 SSID"

msgid "Enter an address or generate one; it stays unchanged until you edit and apply it"
msgstr "填写地址或点击生成；保存并应用后固定使用，直到再次修改"

msgid "Enter or generate a fixed private MAC for each private uplink"
msgstr "请为启用隐私 MAC 的每条线路填写或生成固定地址"

msgid "Enter the complete text normally returned by the check URL; only leading and trailing whitespace is ignored"
msgstr "填写检测地址正常返回的完整正文；仅忽略首尾空白"

msgid "Enter the expected response body before enabling a non-204 internet check"
msgstr "使用非 204 检测时，请先填写预期响应正文"

msgid "Enter the username, service and password before enabling recovery"
msgstr "请先填写校园网账号、账号类型和密码，再启用自动恢复"

msgid "Errors"
msgstr "错误"

msgid "Ethernet"
msgstr "有线网络"

msgid "Ethernet and Wi-Fi cycle through this list in order; skip the address used by the other connection"
msgstr "有线和无线按列表顺序循环使用；跳过另一条线路正在使用的地址"

msgid "Ethernet and Wi-Fi must use different private MAC addresses"
msgstr "有线与无线的隐私 MAC 地址不能相同"

msgid "Event"
msgstr "事件"

msgid "Every N hours"
msgstr "每隔若干小时"

msgid "Failed login-page checks before switching"
msgstr "切换线路前的登录页检测失败次数"

msgid "Failover and return"
msgstr "切换与回切"

msgid "Finding the portal"
msgstr "正在查找校园网登录页"

msgid "First recovery retry delay (seconds)"
msgstr "首次恢复重试的等待时间（秒）"

msgid "Fixed private MAC address"
msgstr "固定隐私 MAC 地址"

msgid "Fixed private MAC for Ethernet"
msgstr "有线固定隐私 MAC 地址"

msgid "Fixed private MAC for Wi-Fi"
msgstr "无线固定隐私 MAC 地址"

msgid "Friday"
msgstr "星期五"

msgid "General settings"
msgstr "常规设置"

msgid "Generate"
msgstr "生成"

msgid "Generate MAC pool"
msgstr "生成 MAC 地址池"

msgid "Generate a new pool after the retries below fail; existing campus device records are not deleted"
msgstr "下方设置的池内重试用完后生成一组新地址；不会删除校园网已有设备记录"

msgid "Generate pool"
msgstr "生成地址池"

msgid "HTTP status returned when online"
msgstr "联网时应返回的 HTTP 状态码"

msgid "Hide"
msgstr "隐藏"

msgid "Hide entered password"
msgstr "隐藏本次输入的密码"

msgid "Huawei"
msgstr "华为"

msgid "In use"
msgstr "正在使用"

msgid "Includes repeated checks when both internet and the login page are unreachable; wait for the configured cooldown after the limit is reached"
msgstr "公网和登录页都无法访问时，复查也计入次数；达到上限后暂停一段时间，再重新尝试"

msgid "Includes switching back to the preferred connection; zero disables switching; counts reset after stable recovery"
msgstr "切回首选线路也计入次数；设为 0 时不自动切换，稳定联网后重新计数"

msgid "Information"
msgstr "信息"

msgid "Initialization could not finish; check the router before trying again"
msgstr "重置未能完成，请检查路由器状态后再试"

msgid "Initialization is taking longer than expected; check the status before trying again"
msgstr "重置还未完成，请先查看当前状态，不要重复提交"

msgid "Interface"
msgstr "接口"

msgid "Internet access"
msgstr "公网连接"

msgid "Internet access check"
msgstr "公网连通性检测"

msgid "Internet and the login page are both unreachable; waiting to check again"
msgstr "公网和校园网登录页都无法访问，稍后重试"

msgid "Internet check URL"
msgstr "公网检测地址"

msgid "Internet checks after a successful login"
msgstr "认证成功后的公网复查次数"

msgid "Internet request failed"
msgstr "公网检测请求失败"

msgid "Keep the backup connected"
msgstr "始终保持连接"

msgid "Keepalive was not confirmed; checking internet access"
msgstr "未收到校园网的保活确认，正在检查公网连接"

msgid "Last action"
msgstr "上次操作"

msgid "Leave blank to keep the saved password; enter and save a new password to replace it"
msgstr "不修改请留空；填写新密码并保存后，会替换原密码"

msgid "Level"
msgstr "级别"

msgid "Log level"
msgstr "日志级别"

msgid "Log out and pause"
msgstr "注销并暂停"

msgid "Log out of the campus network before a scheduled MAC change"
msgstr "定时更换 MAC 前退出校园网登录"

msgid "Login attempts with the same MAC"
msgstr "同一 MAC 的认证次数上限"

msgid "Login succeeded, but internet access failed"
msgstr "认证已通过，但仍无法访问公网"

msgid "Login succeeded; waiting for internet access or a new network address"
msgstr "认证已通过，正在等待网络放行或分配新地址"

msgid "Longest recovery retry delay (seconds)"
msgstr "恢复重试的最长等待时间（秒）"

msgid "MAC addresses"
msgstr "MAC 地址"

msgid "MAC pool regenerated after repeated connection failures"
msgstr "多次连接失败，已生成一组新的 MAC 地址"

msgid "MAC recovery limits reached"
msgstr "更换 MAC 后仍未恢复连接，已停止重试"

msgid "MAC retries before rebuilding a pool"
msgstr "重建前的池内换址重试次数"

msgid "Manually"
msgstr "手动返回"

msgid "Maximum delay must be at least the initial delay"
msgstr "最大重试间隔不能小于初始间隔"

msgid "Minimum time between MAC changes (seconds)"
msgstr "两次更换 MAC 的最短间隔（秒）"

msgid "Monday"
msgstr "星期一"

msgid "More actions"
msgstr "更多操作"

msgid "More than one portal context was found"
msgstr "发现多个不同的登录页面，无法确定该使用哪一个"

msgid "Network interface"
msgstr "网络接口"

msgid "Next rotation"
msgstr "下次更换 MAC"

msgid "No events yet"
msgstr "暂无事件"

msgid "No open networks found; you can enter a custom network"
msgstr "未找到无需密码的 Wi-Fi，可以手动填写网络名称"

msgid "No password saved"
msgstr "尚未保存密码"

msgid "No portal redirect found"
msgstr "未找到校园网登录页"

msgid "No usable authentication response received"
msgstr "未收到有效的认证结果"

msgid "Not authenticated"
msgstr "尚未认证"

msgid "Not checked"
msgstr "尚未检测"

msgid "Not configured"
msgstr "未配置"

msgid "Not enabled"
msgstr "未启用"

msgid "Not monitored"
msgstr "尚未检测"

msgid "Number of MAC addresses to generate"
msgstr "生成的 MAC 地址数量"

msgid "One successful check confirms internet access; repeated failures continue the recovery process"
msgstr "检测成功一次即可确认联网；如果连续失败，会继续尝试恢复连接"

msgid "Optional access point BSSID"
msgstr "接入点 BSSID（选填）"

msgid "Outage confirmation"
msgstr "故障确认"

msgid "Password"
msgstr "密码"

msgid "Password is saved"
msgstr "已保存密码"

msgid "Paused"
msgstr "已暂停"

msgid "Paused after manual logout"
msgstr "已执行注销操作，自动连接已暂停"

msgid "Pool rebuilds per outage"
msgstr "每次故障的地址池重建上限"

msgid "Pool regenerations"
msgstr "地址池重建次数"

msgid "Portal is available"
msgstr "已找到校园网登录页"

msgid "Portal request failed"
msgstr "校园网登录页访问失败"

msgid "Preferred"
msgstr "首选"

msgid "Preferred connection check interval (seconds)"
msgstr "首选线路的恢复检测间隔（秒）"

msgid "Preferred uplink"
msgstr "首选线路"

msgid "Private MAC"
msgstr "隐私 MAC"

msgid "Queued"
msgstr "等待执行"

msgid "Reachable"
msgstr "可访问"

msgid "Reauthentication, MAC changes, switching and logout may interrupt this connection; logout pauses automatic recovery"
msgstr "重新认证、更换 MAC、切换线路或注销都可能导致短暂断网；注销后会暂停自动恢复"

msgid "Rebuild the pool after MAC retries fail"
msgstr "池内重试失败后重建地址池"

msgid "Recent events"
msgstr "最近事件"

msgid "Recovery"
msgstr "故障恢复"

msgid "Recovery attempts before cooldown"
msgstr "进入冷却前的恢复尝试次数"

msgid "Recovery is paused"
msgstr "自动恢复已暂停"

msgid "Recovery rounds / MAC changes"
msgstr "恢复轮数 / MAC 更换次数"

msgid "Replaces the list above; save and apply to use it; existing campus device records are not removed"
msgstr "替换上方列表，保存并应用后生效；校园网已有的设备记录不会被删除"

msgid "Reset"
msgstr "重置"

msgid "Reset completely"
msgstr "彻底重置"

msgid "Reset settings"
msgstr "重置设置"

msgid "Response text returned when online"
msgstr "联网时应返回的正文"

msgid "Restore all plugin defaults and clear saved data, including the campus account and password"
msgstr "恢复全部默认设置，并删除已保存的校园网账号、密码和其他插件数据"

msgid "Restore default settings and clear private MAC addresses, schedules, runtime records and pending changes; keep the campus account, password and account type"
msgstr "恢复默认设置，清除 MAC 地址、定时计划、运行记录和未应用的修改；保留校园网账号、密码和账号类型"

msgid "Resume recovery"
msgstr "恢复自动连接"

msgid "Resume recovery before this action"
msgstr "请先恢复自动连接，再执行此操作"

msgid "Resume recovery on the status page before authenticating"
msgstr "请先在状态页点击“恢复自动连接”，再进行认证"

msgid "Resuming"
msgstr "正在恢复"

msgid "Retry authentication"
msgstr "重新认证"

msgid "Retry interval for login-page detection (seconds)"
msgstr "登录页检测失败后的重试间隔（秒）"

msgid "Rotate MAC and reconnect"
msgstr "更换 MAC 并重新连接"

msgid "Saturday"
msgstr "星期六"

msgid "Save and apply the account settings before authenticating"
msgstr "账号设置已修改，请先点击“保存并应用”，再进行认证"

msgid "Scanning networks"
msgstr "正在扫描网络"

msgid "Schedule type"
msgstr "计划类型"

msgid "Scheduled MAC changes"
msgstr "定时更换 MAC"

msgid "Select a network"
msgstr "选择网络"

msgid "Select a network or enter a custom SSID"
msgstr "请选择网络或填写自定义 SSID"

msgid "Select a radio"
msgstr "选择无线网卡"

msgid "Select a radio first"
msgstr "请先选择无线网卡"

msgid "Select an existing network interface"
msgstr "请选择已有的网络接口"

msgid "Select an existing wireless client; Create one in Network → Wireless if needed"
msgstr "选择已配置的无线客户端；如果还没有，请先到“网络 → 无线”中添加"

msgid "Send login details only to this server; include the scheme and optional port, without a path"
msgstr "账号密码只发送到这个服务器；请填写协议、主机和端口，不要添加路径"

msgid "Service is running"
msgstr "服务正在运行"

msgid "Service is stopped"
msgstr "服务已停止"

msgid "Service started"
msgstr "服务已启动"

msgid "Service status"
msgstr "服务状态"

msgid "Set the MAC retry count above zero before enabling automatic pool regeneration"
msgstr "启用自动重建前，请将 MAC 重试次数设为大于 0"

msgid "Settings"
msgstr "设置"

msgid "Shared MAC pool"
msgstr "共享 MAC 地址池"

msgid "Show"
msgstr "显示"

msgid "Show entered password"
msgstr "显示本次输入的密码"

msgid "Some saved network settings could not be restored; review the restoration journal"
msgstr "部分网络设置未能恢复，请查看恢复记录"

msgid "Staff"
msgstr "教职工"

msgid "Starting"
msgstr "正在启动"

msgid "Status"
msgstr "状态"

msgid "Stopped"
msgstr "已停止"

msgid "Stopping the service and restoring network settings before clearing data"
msgstr "正在停止服务、恢复原有网络设置，完成后会清除相应数据"

msgid "Student"
msgstr "学生"

msgid "Sunday"
msgstr "星期日"

msgid "Switches this outage"
msgstr "本次故障切换次数"

msgid "The MAC policy, interval or rotation budget prevents this action"
msgstr "暂时无法更换 MAC，请检查更换策略、最短间隔和次数限制"

msgid "The configuration is enabled, but the service is not running; save and apply to start it"
msgstr "服务已勾选启用，但还没有运行；请点击“保存并应用”启动"

msgid "The connection changed; the earlier private MAC session was not logged out"
msgstr "线路已经变化，未注销之前的校园网连接"

msgid "The discovered portal does not match the configured origin"
msgstr "找到的登录服务器与设置不一致，已停止认证"

msgid "The internet check was redirected to the configured login portal"
msgstr "公网检测跳转到了校园网登录页，需要认证"

msgid "The portal IP and MAC match the current uplink"
msgstr "登录页中的 IP 和 MAC 与当前线路一致"

msgid "The portal RSA mode does not support these password characters"
msgstr "校园网的密码加密方式不支持密码中的部分字符"

msgid "The portal confirmed logout of the private MAC session; restoring the network"
msgstr "校园网已确认注销，正在恢复原有网络设置"

msgid "The portal rejected authentication; check the account before resuming"
msgstr "校园网拒绝了认证，请检查账号和密码后再恢复自动连接"

msgid "The portal requires an additional authentication step"
msgstr "校园网要求额外验证，请先完成验证"

msgid "The saved configuration is invalid; review the settings before starting"
msgstr "当前设置有误，请修改后再启动服务"

msgid "The selected service is not offered by the portal"
msgstr "校园网不支持所选的账号类型，请检查账号设置"

msgid "The service could not start; check the configuration and preflight result"
